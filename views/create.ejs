<% include ./partials/header.ejs %>
<link rel="stylesheet" href="/stylesheets/profile.css">
<div class="w-full min-h-screen bg-[#252529] px-10 py-3 text-white">

<h1 class="mt-3">Create Pin.</h1>
<hr class="opacity-10 mt-3">

<form action="/upload" method="post" enctype="multipart/form-data">
<input type="file" name="file" class=" w-1/3 px-3 py-2 block rounded-xl border-none mt-2">
<h2 class="mt-2">Title</h2>
<input type="text" name="title" placeholder="Add a Title" class=" w-1/3 px-3 py-2 block rounded-xl mt-2 text-black">
<h2 class="mt-3">Description</h2>
<textarea type="text" name="description" placeholder="Add a Description" class=" w-1/3 px-3 py-2 block  rounded-xl mt-2 text-black"></textarea>
<button type="submit" class="px-3 bg-[#e60023] hover:bg-red-700 w-1/3 py-2 block rounded-xl mt-3 font-semibold">Publish</button>
</form>
</div>
<% include ./partials/footer %>